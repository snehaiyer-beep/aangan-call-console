# Copy to .env.local and fill in. Server-only — never prefix with NEXT_PUBLIC_.

VAANI_API_KEY=
VAANI_WEBHOOK_SECRET=

HUBSPOT_ACCESS_TOKEN=
# HUBSPOT_PIPELINE_ID=default
# HUBSPOT_STAGE_QUALIFIED=appointmentscheduled
# HUBSPOT_STAGE_NURTURE=qualifiedtobuy
# HUBSPOT_STAGE_OUT_OF_SCOPE=closedlost

# Console login
CONSOLE_USER=aangan
CONSOLE_PASSWORD=

# Supabase (database for call history). Server-only — never NEXT_PUBLIC_.
# Project Settings → API: Project URL, and the secret key (sb_secret_…) or legacy service_role key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Set to true to remove the console login (makes caller data public)
CONSOLE_PUBLIC=

# Show the Sept 2026 example calls (demo only)
SHOW_SEED_CALLS=

# Cal.com — the console books the 15-min discovery call after each qualified call
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
